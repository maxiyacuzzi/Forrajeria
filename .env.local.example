# Valores impresos por `supabase start` (o los de tu proyecto en supabase.com para producción).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key del proyecto de Supabase — Settings > API. Solo se usa server-side
# (route handlers) para escribir los tokens de Mercado Pago; nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Credenciales de la app creada en https://www.mercadopago.com.ar/developers/panel/app
# para el flujo de OAuth "Conectar con Mercado Pago".
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Debe coincidir exactamente con el redirect_uri configurado en el panel de MP.
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/mercadopago/callback
# Secret del webhook (panel de la app > Webhooks). Valida la firma x-signature
# de las notificaciones en /api/mercadopago/webhook.
MERCADOPAGO_WEBHOOK_SECRET=

# Solo stage/local, NUNCA en producción: Access Token de prueba de la app
# (panel > Credenciales de prueba). El sandbox de Mercado Pago no crea órdenes
# con el token OAuth de un usuario de prueba; se usa solo si la cuenta
# conectada es ese mismo vendedor de prueba.
MERCADOPAGO_TEST_ACCESS_TOKEN=
